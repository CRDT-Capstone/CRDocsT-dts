{
  "name": "@cr_docs_t/dts",
  "version": "0.35.1",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "wasm": "cp -r ./src/wasm ./dist",
    "postbuild": "npm run wasm",
    "prebuild": "npm run gen-types",
    "bench": "npm run exp && npm run table",
    "exp": "tsx --expose-gc ./src/benchmarks/FugueTree/run.ts",
    "table": "echo 'FugueTree results: \n\n' && node ./src/benchmarks/bin/render-table.js ./bench_results.json 6000 fugue-tree",
    "prepublishOnly": "npm run test",
    "test": "NODE_OPTIONS='--experimental-vm-modules --expose-gc' jest",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --passWithNoTests",
    "ci": "npm install --frozen-lockfile && npm run test:ci",
    "pretest": "npm run build",
    "gen-types": "tsx ./src/type-gen.ts && biome format --write ./src/treesitter/types/AST.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./treesitter": {
      "import": "./dist/treesitter.js",
      "require": "./dist/treesitter.js",
      "types": "./dist/treesitter.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CRDT-Capstone/CRDocsT-dts.git"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "keywords": [],
  "author": [
    "Madiba Hudson-Quansah",
    "Tanitoluwa Olamiji Adebayo"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@jest/globals": "^30.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lz4js": "^0.2.2",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@types/seedrandom": "^3.0.8",
    "isomorphic.js": "^0.2.5",
    "jest": "^30.2.0",
    "lib0": "^0.2.117",
    "mathjs": "^15.1.1",
    "seedrandom": "^3.0.5",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "lz4js": "^0.2.0",
    "pako": "^2.1.0",
    "uuid": "^13.0.0",
    "web-tree-sitter": "^0.26.5",
    "zod": "^4.3.6"
  }
}
