{
    "name": "@cr_docs_t/dts",
    "version": "0.32.0",
    "description": "",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "prebuild": "pnpm run gen-types",
        "prepublishOnly": "pnpm run test",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --passWithNoTests",
        "ci": "pnpm install --frozen-lockfile && pnpm run test:ci",
        "pretest": "pnpm run build",
        "gen-types": "tsx ./src/type-gen.ts && biome format --write ./src/treesitter/types/AST.ts"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./treesitter": {
            "import": "./dist/treesitter.js",
            "require": "./dist/treesitter.js",
            "types": "./dist/treesitter.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CRDT-Capstone/CRDocsT-dts.git"
    },
    "release": {
        "branches": [
            "master"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            "@semantic-release/npm",
            "@semantic-release/github",
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "CHANGELOG.md"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
                }
            ]
        ]
    },
    "keywords": [],
    "author": [
        "Madiba Hudson-Quansah",
        "Tanitoluwa Olamiji Adebayo"
    ],
    "license": "ISC",
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "@biomejs/biome": "2.4.4",
        "@jest/globals": "^30.2.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/lz4js": "^0.2.2",
        "@types/node": "^24.10.1",
        "@types/pako": "^2.0.4",
        "jest": "^30.2.0",
        "semantic-release": "^25.0.2",
        "ts-jest": "^29.4.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "fastpriorityqueue": "^0.8.0",
        "@types/object-hash": "^3.0.6",
        "lz4js": "^0.2.0",
        "pako": "^2.1.0",
        "uuid": "^13.0.0",
        "web-tree-sitter": "^0.26.5",
        "zod": "^4.3.6",
        "object-hash": "^3.0.0"
    }
}
