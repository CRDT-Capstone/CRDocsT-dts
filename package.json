{
  "name": "@cr_docs_t/dts",
  "version": "0.26.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prebuild": "npm run gen-types",
    "prepublishOnly": "npm run build",
    "ci": "npm install && npm run build",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "gen-types": "tsx ./src/type-gen.ts && biome format --write ./src/treesitter/types/AST.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./treesitter": {
      "import": "./dist/treesitter.js",
      "require": "./dist/treesitter.js",
      "types": "./dist/treesitter.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CRDT-Capstone/CRDocsT-dts.git"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "keywords": [],
  "author": [
    "Madiba Hudson-Quansah",
    "Tanitoluwa Olamiji Adebayo"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lz4js": "^0.2.2",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fastpriorityqueue": "^0.8.0",
    "lz4js": "^0.2.0",
    "mnemonist": "^0.40.3",
    "uuid": "^13.0.0",
    "web-tree-sitter": "^0.26.5",
    "zod": "^4.3.6"
  }
}
